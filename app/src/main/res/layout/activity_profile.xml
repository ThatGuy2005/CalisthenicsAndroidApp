<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/profileBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹  Settings"
            android:textColor="@color/performance_orange_dark"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="YOUR ACCOUNT"
            android:textColor="@color/performance_orange_dark"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Edit profile"
            android:textColor="@color/performance_graphite"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"
            android:text="Keep your details up to date for a more personal training experience."
            android:textColor="@color/performance_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="7dp"
            android:text="Username"
            android:textColor="@color/performance_muted"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/profileUsername"
            style="@style/SignupField"
            android:hint="Username"
            android:inputType="text"
            android:maxLength="20" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="7dp"
            android:text="Email address"
            android:textColor="@color/performance_muted"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/profileEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_background"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/performance_muted"
            android:textSize="15sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="5dp"
            android:text="To change your email, use Account security in Settings."
            android:textColor="@color/performance_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="7dp"
            android:id="@+id/profileHeightLabel"
            android:text="@string/profile_height_label_metric"
            android:textColor="@color/performance_muted"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/profileHeight"
            style="@style/SignupField"
            android:hint="Height in cm"
            android:inputType="numberDecimal" />
        <LinearLayout
            android:id="@+id/profileHeightImperial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/profileHeightFeet"
                style="@style/SignupField"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:hint="@string/height_hint_feet"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1" />

            <EditText
                android:id="@+id/profileHeightInches"
                style="@style/SignupField"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/height_hint_inches"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="2" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="7dp"
            android:id="@+id/profileWeightLabel"
            android:text="@string/profile_weight_label_metric"
            android:textColor="@color/performance_muted"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/profileWeight"
            style="@style/SignupField"
            android:hint="Weight in kg"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="7dp"
            android:text="Gender · optional"
            android:textColor="@color/performance_muted"
            android:textSize="13sp" />
        <Spinner
            android:id="@+id/profileGender"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:popupBackground="@color/performance_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="7dp"
            android:text="Birth year · optional"
            android:textColor="@color/performance_muted"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/profileBirthYear"
            style="@style/SignupField"
            android:hint="e.g. 1995"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:text="Height, weight and birth year help estimate calories during workouts."
            android:textColor="@color/performance_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/profileSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/performance_orange"
            android:text="Save profile"
            android:textAllCaps="false"
            android:textColor="@color/performance_ink"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
