<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/customWorkoutDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/page_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="20dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">
            <TextView android:id="@+id/customWorkoutBack" android:layout_width="wrap_content"
                android:layout_height="48dp" android:gravity="center_vertical"
                android:text="‹  My workouts" android:textColor="@color/performance_orange_dark"
                android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="YOUR ROUTINE"
                android:textColor="@color/performance_orange_dark" android:textSize="12sp"
                android:letterSpacing="0.1" android:textStyle="bold" />
            <TextView android:id="@+id/customWorkoutDetailName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="Workout" android:textColor="@color/performance_graphite"
                android:textSize="29sp" android:textStyle="bold" />
            <TextView android:id="@+id/customWorkoutDetailMeta" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textColor="@color/performance_orange_dark" android:textSize="14sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/customWorkoutDetailDescription" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textColor="@color/performance_muted" android:textSize="15sp" />
            <TextView android:id="@+id/customWorkoutDetailCount" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp" android:text="EXERCISES"
                android:textColor="@color/performance_muted" android:textSize="12sp"
                android:textStyle="bold" />
            <LinearLayout android:id="@+id/customWorkoutDetailExercises" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView android:id="@+id/customWorkoutStart" android:layout_width="match_parent"
        android:layout_height="56dp" android:layout_marginStart="22dp" android:layout_marginEnd="22dp"
        android:layout_marginBottom="12dp" android:background="@drawable/workout_primary_button"
        android:gravity="center" android:text="Start workout" android:textColor="@color/performance_ink"
        android:textSize="16sp" android:textStyle="bold" />
</LinearLayout>
