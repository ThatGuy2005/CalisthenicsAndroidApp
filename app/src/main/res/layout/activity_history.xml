<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/historyRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/page_background">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="22dp"
            android:paddingEnd="20dp" android:paddingBottom="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CALISTHENICS" android:textColor="@color/performance_orange_dark" android:textSize="12sp"
                android:textStyle="bold" android:letterSpacing="0.12" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Training history"
                android:textColor="@color/performance_graphite" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="Your progress, one workout at a time."
                android:textColor="@color/performance_muted" android:textSize="14sp" />

            <LinearLayout android:id="@+id/historyPeriodPicker" android:layout_width="match_parent"
                android:layout_height="46dp" android:layout_marginTop="20dp" android:orientation="horizontal"
                android:padding="3dp" android:background="@drawable/home_tile_background">
                <TextView android:id="@+id/historyWeek" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"
                    android:text="This week" android:textColor="@color/performance_ink" android:textSize="12sp"
                    android:textStyle="bold" android:background="@drawable/workout_primary_button"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/historyMonth" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"
                    android:text="This month" android:textColor="@color/performance_muted" android:textSize="12sp"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/historyAllTime" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"
                    android:text="All time" android:textColor="@color/performance_muted" android:textSize="12sp"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
                    android:layout_height="106dp" android:layout_weight="1" android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="@color/performance_feature" app:cardCornerRadius="18dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center_vertical" android:orientation="vertical" android:padding="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="WORKOUTS" android:textColor="#D8E9DD" android:textSize="10sp"
                            android:textStyle="bold" android:letterSpacing="0.07" />
                        <TextView android:id="@+id/historyWorkoutTotal" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0"
                            android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
                    android:layout_height="106dp" android:layout_weight="1" android:layout_marginHorizontal="5dp"
                    app:cardBackgroundColor="@color/performance_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp"
                    app:strokeColor="@color/performance_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center_vertical" android:orientation="vertical" android:padding="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="TRAINING TIME" android:textColor="@color/performance_muted" android:textSize="10sp"
                            android:textStyle="bold" android:letterSpacing="0.04" />
                        <TextView android:id="@+id/historyTimeTotal" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0 min"
                            android:textColor="@color/performance_graphite" android:textSize="20sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
                    android:layout_height="106dp" android:layout_weight="1" android:layout_marginStart="5dp"
                    app:cardBackgroundColor="@color/performance_orange_tint" app:cardCornerRadius="18dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center_vertical" android:orientation="vertical" android:padding="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="CALORIES" android:textColor="@color/performance_muted" android:textSize="10sp"
                            android:textStyle="bold" android:letterSpacing="0.06" />
                        <TextView android:id="@+id/historyCaloriesTotal" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0 kcal"
                            android:textColor="@color/performance_graphite" android:textSize="19sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <TextView android:id="@+id/historyCompletionLine" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="11dp"
                android:text="0 completed  ·  0 partial" android:textColor="@color/performance_muted" android:textSize="12sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Recent workouts" android:textColor="@color/performance_graphite" android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView android:id="@+id/historyLogCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0 workouts" android:textColor="@color/performance_muted"
                    android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/historyLoading" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:text="Loading your workouts…" android:textColor="@color/performance_muted" android:textSize="14sp" />
            <LinearLayout android:id="@+id/historyLogList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNavigation"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/performance_surface"
        app:itemIconTint="@color/performance_nav_colors" app:itemTextColor="@color/performance_nav_colors" app:labelVisibilityMode="labeled"
        app:menu="@menu/home_bottom_navigation" />
</LinearLayout>
