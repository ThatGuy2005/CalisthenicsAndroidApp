<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/privacyPolicyBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/privacy_policy_back"
            android:textColor="@color/performance_orange_dark"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/data_privacy_eyebrow"
            android:textColor="@color/performance_orange_dark"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/privacy_policy_title"
            android:textColor="@color/performance_graphite"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/privacyPolicyBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/performance_muted"
            android:textColorLink="@color/performance_orange_dark"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
