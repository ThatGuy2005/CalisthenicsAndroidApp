<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/summaryRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/page_background">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="22dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="WORKOUT COMPLETE" android:textColor="@color/performance_orange_dark" android:textSize="12sp"
                android:letterSpacing="0.12" android:textStyle="bold" />
            <TextView android:id="@+id/summaryTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Nice work!"
                android:textColor="@color/performance_graphite" android:textSize="32sp" android:textStyle="bold" />
            <TextView android:id="@+id/summaryWorkoutName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Workout"
                android:textColor="@color/performance_muted" android:textSize="16sp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/performance_surface" app:cardCornerRadius="22dp"
                app:strokeColor="@color/performance_border" app:strokeWidth="1dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="DURATION" android:textColor="@color/performance_muted" android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView android:id="@+id/summaryDuration" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginTop="5dp"
                                android:text="00:00" android:textColor="@color/performance_graphite" android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="CALORIES" android:textColor="@color/performance_muted" android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView android:id="@+id/summaryCalories" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginTop="5dp"
                                android:text="0 kcal" android:textColor="@color/performance_graphite" android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginVertical="14dp" android:background="@color/performance_border" />
                    <TextView android:id="@+id/summarySets" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="0 sets completed"
                        android:textColor="@color/performance_orange_dark" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/summarySaved" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="Saving your workout…" android:textColor="@color/performance_muted" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:layout_marginBottom="10dp" android:text="YOUR EXERCISES"
                android:textColor="@color/performance_muted" android:textSize="12sp" android:letterSpacing="0.1"
                android:textStyle="bold" />
            <LinearLayout android:id="@+id/summaryExerciseList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="10dp"
        android:paddingBottom="14dp" android:background="@drawable/page_background">
        <TextView android:id="@+id/summaryHome" android:layout_width="match_parent"
            android:layout_height="52dp" android:gravity="center" android:text="Back to home"
            android:textColor="@color/performance_ink" android:textSize="15sp" android:textStyle="bold"
            android:background="@drawable/workout_primary_button" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/summaryWorkouts" android:layout_width="match_parent"
            android:layout_height="44dp" android:layout_marginTop="6dp" android:gravity="center"
            android:text="Choose another workout" android:textColor="@color/performance_orange_dark" android:textSize="14sp"
            android:textStyle="bold" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</LinearLayout>
