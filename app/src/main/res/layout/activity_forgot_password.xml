<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/forgotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/forgotBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/signup_back"
            android:textColor="@color/performance_orange_dark"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/forgot_title"
            android:textColor="@color/performance_graphite"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="@string/forgot_subtitle"
            android:textColor="@color/performance_muted"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/forgotEmail"
            android:autofillHints="emailAddress"
            style="@style/SignupField"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            android:maxLength="254" />

        <Button
            android:id="@+id/sendResetButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/performance_orange"
            android:text="@string/forgot_send"
            android:textAllCaps="false"
            android:textColor="@color/performance_graphite"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/resetSentMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/forgot_sent"
            android:textColor="@color/performance_orange_dark"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
