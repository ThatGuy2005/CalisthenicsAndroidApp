<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/backToLogin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹  Back to login"
            android:textColor="#376B4B"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Create account"
            android:textColor="#1D2B22"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="A few details to get your training started"
            android:textColor="#68746B"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/signupUsername"
            style="@style/SignupField"
            android:hint="Username"
            android:inputType="text" />

        <EditText
            android:id="@+id/signupEmail"
            style="@style/SignupField"
            android:hint="Email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/signupPassword"
            style="@style/SignupField"
            android:hint="Password (at least 8 characters)"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/signupHeight"
            style="@style/SignupField"
            android:hint="Height (cm) — optional"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/signupWeight"
            style="@style/SignupField"
            android:hint="Weight (kg) — optional"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/signupBirthYear"
            style="@style/SignupField"
            android:hint="Birth year — optional"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="Gender (optional)"
            android:textColor="#526057"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/signupGender"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/createAccountButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#376B4B"
            android:text="Create account"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
