<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/backToLogin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹  Back to login"
            android:textColor="@color/performance_orange_dark"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Create account"
            android:textColor="@color/performance_graphite"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="A few details to get your training started"
            android:textColor="@color/performance_muted"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/signupUsername"
            style="@style/SignupField"
            android:hint="Username"
            android:inputType="text"
            android:maxLength="20" />

        <EditText
            android:id="@+id/signupEmail"
            style="@style/SignupField"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:maxLength="254" />

        <EditText
            android:id="@+id/signupPassword"
            style="@style/SignupField"
            android:hint="Password (at least 8 characters)"
            android:inputType="textPassword"
            android:maxLength="64" />

        <CheckBox
            android:id="@+id/signupShowPasswordCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:layout_marginBottom="8dp"
            android:buttonTint="@color/performance_orange"
            android:text="Show password"
            android:textColor="@color/performance_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/signupProfileNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:text="Optional profile details · height and weight help estimate calories"
            android:textColor="@color/performance_muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/signupHeight"
            style="@style/SignupField"
            android:hint="Height (cm) — optional"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/signupWeight"
            style="@style/SignupField"
            android:hint="Weight (kg) — optional"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="Gender (optional)"
            android:textColor="@color/performance_muted"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/signupGender"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_background"
            android:popupBackground="@color/performance_surface"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/createAccountButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/performance_orange"
            android:text="Create account"
            android:textAllCaps="false"
            android:textColor="@color/performance_ink"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
