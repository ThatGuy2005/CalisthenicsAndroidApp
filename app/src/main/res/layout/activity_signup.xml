<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/backToLogin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/signup_back"
            android:textColor="@color/performance_orange_dark"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/signup_create_account"
            android:textColor="@color/performance_graphite"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="@string/signup_subtitle"
            android:textColor="@color/performance_muted"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/signupUsername"
            android:autofillHints="newUsername"
            style="@style/SignupField"
            android:hint="@string/signup_hint_username"
            android:inputType="text"
            android:maxLength="20" />

        <EditText
            android:id="@+id/signupEmail"
            android:autofillHints="emailAddress"
            style="@style/SignupField"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            android:maxLength="254" />

        <EditText
            android:id="@+id/signupPassword"
            android:autofillHints="newPassword"
            style="@style/SignupField"
            android:hint="@string/signup_hint_password"
            android:inputType="textPassword"
            android:maxLength="64" />

        <TextView
            android:id="@+id/signupProfileNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:text="@string/signup_optional_note"
            android:textColor="@color/performance_muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/signupHeight"
            android:importantForAutofill="no"
            style="@style/SignupField"
            android:hint="@string/signup_hint_height"
            android:inputType="numberDecimal" />

        <LinearLayout
            android:id="@+id/signupHeightImperial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/signupHeightFeet"
                style="@style/SignupField"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:hint="@string/height_hint_feet"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1" />

            <EditText
                android:id="@+id/signupHeightInches"
                style="@style/SignupField"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/height_hint_inches"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="2" />
        </LinearLayout>

        <EditText
            android:id="@+id/signupWeight"
            android:importantForAutofill="no"
            style="@style/SignupField"
            android:hint="@string/signup_hint_weight"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/signupBirthYear"
            android:autofillHints="birthDateYear"
            style="@style/SignupField"
            android:hint="@string/signup_hint_birth_year"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="@string/signup_gender_label"
            android:textColor="@color/performance_muted"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/signupGender"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_background"
            android:popupBackground="@color/performance_surface"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/createAccountButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/performance_orange"
            android:text="@string/signup_create_account"
            android:textAllCaps="false"
            android:textColor="@color/performance_ink"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
