<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="52dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand"
            android:textColor="@color/performance_orange_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.16" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login_title"
            android:textColor="@color/performance_graphite"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/login_subtitle"
            android:textColor="@color/performance_muted"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/emailInput"
            android:autofillHints="emailAddress"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/input_background"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            android:maxLength="254"
            android:textColor="@color/performance_graphite"
            android:textColorHint="@color/performance_muted"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true" />

        <!-- The layout draws the field's box, so the eye icon sits inside it. -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/input_background"
            app:boxBackgroundMode="none"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/performance_muted"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordInput"
                android:autofillHints="password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/login_hint_password"
                android:textColor="@color/performance_graphite"
                android:textColorHint="@color/performance_muted"
                android:inputType="textPassword"
                android:maxLength="64"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/forgotPasswordButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="@string/login_forgot_password"
            android:textAllCaps="false"
            android:textColor="@color/performance_orange_dark"
            android:textSize="15sp" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/performance_orange"
            android:text="@string/login_button"
            android:textAllCaps="false"
            android:textColor="@color/performance_ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/login_new_here"
            android:textColor="@color/performance_muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/openSignupButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/login_create_account"
            android:textAllCaps="false"
            android:textColor="@color/performance_orange_dark"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
