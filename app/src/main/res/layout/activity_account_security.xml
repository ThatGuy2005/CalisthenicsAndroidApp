<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/securityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/securityBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/profile_back"
            android:textColor="@color/performance_orange_dark"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/profile_eyebrow"
            android:textColor="@color/performance_orange_dark"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/security_title"
            android:textColor="@color/performance_graphite"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/security_subtitle"
            android:textColor="@color/performance_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"
            android:text="@string/security_password_title"
            android:textColor="@color/performance_graphite"
            android:textSize="21sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/securityCurrentPassword"
            style="@style/SignupField"
            android:autofillHints="password"
            android:hint="@string/security_hint_current_password"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/securityNewPassword"
            style="@style/SignupField"
            android:autofillHints="newPassword"
            android:hint="@string/security_hint_new_password"
            android:inputType="textPassword"
            android:maxLength="64" />

        <EditText
            android:id="@+id/securityConfirmPassword"
            style="@style/SignupField"
            android:autofillHints="newPassword"
            android:hint="@string/security_hint_confirm_password"
            android:inputType="textPassword"
            android:maxLength="64" />

        <Button
            android:id="@+id/securityChangePassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="2dp"
            android:backgroundTint="@color/performance_orange"
            android:text="@string/security_update_password"
            android:textAllCaps="false"
            android:textColor="@color/performance_ink"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="22dp"
            android:background="@color/performance_border" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/security_email_title"
            android:textColor="@color/performance_graphite"
            android:textSize="21sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/securityEmailCurrentPassword"
            style="@style/SignupField"
            android:autofillHints="password"
            android:hint="@string/security_hint_current_password"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/securityNewEmail"
            style="@style/SignupField"
            android:autofillHints="emailAddress"
            android:hint="@string/security_hint_new_email"
            android:inputType="textEmailAddress"
            android:maxLength="254" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="-4dp"
            android:text="@string/security_email_note"
            android:textColor="@color/performance_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/securityChangeEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/performance_orange"
            android:text="@string/security_send_link"
            android:textAllCaps="false"
            android:textColor="@color/performance_ink"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
