<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/workoutListRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="24dp"
            android:paddingEnd="22dp" android:paddingBottom="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/brand" android:textColor="@color/performance_orange_dark" android:textSize="13sp"
                android:letterSpacing="0.12" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="@string/workout_list_title" android:textColor="@color/performance_graphite"
                android:textSize="30sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/workout_list_subtitle"
                android:textColor="@color/performance_muted" android:textSize="15sp" />
            <Spinner android:id="@+id/workoutCategoryFilter" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="18dp"
                android:background="@drawable/input_background" android:paddingStart="12dp"
                android:paddingEnd="10dp" />
            <TextView android:id="@+id/workoutCount" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp" android:text="@string/workout_list_loading"
                android:textColor="@color/performance_muted" android:textSize="13sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/workoutList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="#FFFFFF"
        app:itemIconTint="@color/performance_orange_dark" app:itemTextColor="@color/performance_muted"
        app:labelVisibilityMode="labeled" app:menu="@menu/home_bottom_navigation" />
</LinearLayout>
