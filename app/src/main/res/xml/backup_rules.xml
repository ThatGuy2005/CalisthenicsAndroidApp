<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and older: nothing is backed up (allowBackup="false" in the manifest already stops
   it, including adb backup); excluded here as well in case backup is ever turned back on. See
   data_extraction_rules.xml for why.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
