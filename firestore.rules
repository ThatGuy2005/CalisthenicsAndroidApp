rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user can read and write only their own data, at any depth
    // under users/{uid} (profile, customWorkouts, workoutLogs, schedules).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Everything else is denied by default.
  }
}
