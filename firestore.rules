rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // usernames/{name}: one document per username in use, with the owner's uid. The id is the
    // lowercased username, and document ids are unique, so creating one claims that name.
    match /usernames/{name} {
      // get only: signed-in users can check one name, but cannot list them all.
      allow get: if signedIn();
      // Only for yourself, and only for the username your profile has after this write,
      // so nobody can hold on to names they are not using.
      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower() == name;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      // No update: a name changes owner only by being released (deleted) and claimed again.
    }

    // A signed-in user can read and write only their own data under users/{uid}.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      // The profile's username must be claimed by this user once the write is done.
      allow create, update: if signedIn() && request.auth.uid == uid
          && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid;

      // Subcollections (customWorkouts, workoutLogs, schedules) at any depth. {collection} keeps
      // this from also matching users/{uid} itself, which a bare {document=**} would do.
      match /{collection}/{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Everything else is denied by default.
  }
}
